# Copie para .env e preencha com valores locais.
# Nunca coloque credenciais reais neste arquivo.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finance_db
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Cloudinary (opcional para avatar)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (recuperação de senha). Se vazio, o link é apenas logado em DEBUG.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@finance.local
SMTP_USE_TLS=true

# Em produção, deixe como false.
DEBUG=false
RATE_LIMIT_ENABLED=true
